# Copy to .env and fill in. .env is ignored by git: never commit real secrets.

# Password for the Postgres database (anything long and random)
POSTGRES_PASSWORD=

# Signs login tokens. At least 32 characters; generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# true creates the demo organisation, courts and accounts on an empty
# database. The demo accounts have public passwords (see README), so only
# use this for a throwaway demo site.
SEED_DEMO_DATA=false

# Port the site is served on
PORT=3000

# Email (optional). Without SMTP_HOST, emails (booking confirmations,
# "you got a slot from the waitlist") are only written to the backend's log.
# Any SMTP provider works, e.g. your email host, Mailgun, SendGrid or Postmark.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Court Booking <no-reply@example.com>
